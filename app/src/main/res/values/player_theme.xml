<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RetroStreamGame" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="colorAccent">#EDE6D6</item>
        <item name="alertDialogTheme">@style/Theme.RetroStreamGame.Dialog</item>
    </style>
    <style name="Theme.RetroStreamGame.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#EDE6D6</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#E9ECF5</item>
        <item name="android:textColor">#E9ECF5</item>
    </style>
</resources>
